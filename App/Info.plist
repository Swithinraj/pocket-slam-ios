<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>CFBundleDisplayName</key>
    <string>SLAM to Go</string>
    <key>NSCameraUsageDescription</key>
    <string>The camera and LiDAR are used for real-time 3D SLAM.</string>
    <key>NSMotionUsageDescription</key>
    <string>Motion sensors (IMU) are fused with camera and LiDAR for tracking.</string>
    <key>UIRequiredDeviceCapabilities</key>
    <array>
        <string>arkit</string>
    </array>
    <key>UISupportedInterfaceOrientations</key>
    <array>
        <string>UIInterfaceOrientationPortrait</string>
    </array>
    <key>UIStatusBarHidden</key>
    <true/>
    <!-- Recordings in Documents/ become visible in the Files app -->
    <key>UIFileSharingEnabled</key>
    <true/>
    <key>LSSupportsOpeningDocumentsInPlace</key>
    <true/>
</dict>
</plist>
